<%- include('../partials/header') %>
<div class="admin-hero">
  <div>
    <span class="dashboard-kicker">Inventory Setup</span>
    <h1>Floors & Rooms</h1>
    <p>Create flexible floor labels such as Ground Floor, First Floor, and Second Floor.</p>
  </div>
  <a class="btn btn-light hero-action" href="/rooms">Manage Rooms</a>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <section class="content-card admin-panel">
      <div class="section-heading">
        <div>
          <span>New floor</span>
          <h2>Add Floor</h2>
        </div>
      </div>
      <form action="/floors" method="post" class="vstack gap-3">
        <div>
          <label class="form-label" for="name">Floor name</label>
          <input class="form-control" id="name" name="name" placeholder="Ground Floor" required>
        </div>
        <div>
          <label class="form-label" for="floorNumber">Floor number</label>
          <input class="form-control" id="floorNumber" name="floorNumber" type="number" min="0" required>
        </div>
        <button class="btn btn-primary" type="submit">Add Floor</button>
      </form>
    </section>
  </div>
  <div class="col-lg-8">
    <section class="content-card admin-panel">
      <div class="section-heading">
        <div>
          <span>Current setup</span>
          <h2>Existing Floors</h2>
        </div>
      </div>
      <% if (!floors.length) { %>
        <p class="text-secondary mb-0">No floors added yet.</p>
      <% } %>
      <div class="vstack gap-3">
        <% floors.forEach(function(floor) { %>
          <div class="editable-row">
            <form action="/floors/<%= floor._id %>?_method=PUT" method="post" class="row g-2 align-items-end flex-grow-1">
              <div class="col-md-6">
                <label class="form-label">Name</label>
                <input class="form-control" name="name" value="<%= floor.name %>" required>
              </div>
              <div class="col-md-3">
                <label class="form-label">Number</label>
                <input class="form-control" name="floorNumber" type="number" min="0" value="<%= floor.floorNumber %>" required>
              </div>
              <div class="col-md-3 action-col">
                <button class="btn btn-outline-primary w-100" type="submit">Save</button>
              </div>
            </form>
            <form class="row-action-form" action="/floors/<%= floor._id %>?_method=DELETE" method="post" onsubmit="return confirm('Delete this floor and any empty rooms under it?');">
              <button class="btn btn-outline-danger" type="submit">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    </section>
  </div>
</div>
<%- include('../partials/footer') %>
