<%- include('../partials/header') %>
<div class="admin-hero">
  <div>
    <h1>Users</h1>
    <p>Create login credentials for trusted users who should access the SKY LINE owner dashboard.</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <section class="content-card admin-panel">
      <div class="section-heading">
        <div>
          <span>New login</span>
          <h2>Create User</h2>
        </div>
      </div>
      <form action="/users" method="post" class="vstack gap-3">
        <div>
          <label class="form-label" for="name">Name</label>
          <input class="form-control" id="name" name="name" required>
        </div>
        <div>
          <label class="form-label" for="email">Email</label>
          <input class="form-control" id="email" name="email" type="email" required>
        </div>
        <div>
          <label class="form-label" for="password">Temporary password</label>
          <input class="form-control" id="password" name="password" type="text" minlength="6" required>
        </div>
        <div>
          <label class="form-label" for="confirmPassword">Confirm password</label>
          <input class="form-control" id="confirmPassword" name="confirmPassword" type="text" minlength="6" required>
        </div>
        <button class="btn btn-primary" type="submit">Create User</button>
      </form>
    </section>
  </div>

  <div class="col-lg-8">
    <section class="content-card admin-panel">
      <div class="section-heading">
        <div>
          <span>Access</span>
          <h2>Existing Users</h2>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table align-middle skyline-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(user) { %>
              <tr>
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td><%= user.accountOwnerId ? 'User' : 'Owner' %></td>
                <td>
                  <span class="badge <%= user.status === 'ACTIVE' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= user.status %></span>
                </td>
                <td>
                  <%= user.createdAt
                    ? user.createdAt.toISOString().slice(0, 10).split('-').reverse().join('-')
                    : '-' %>
                </td>
              </tr>
            <% }) %>
            <% if (!users.length) { %>
              <tr><td colspan="5" class="text-center text-secondary py-4">No users found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
<%- include('../partials/footer') %>
